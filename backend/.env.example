# Sao chép file này thành .env (hoặc chạy "npm run setup" ở thư mục gốc để tạo tự động).

# Cổng của API
PORT=4000

# MongoDB cài trên máy. Nếu dùng MongoDB Atlas, thay bằng chuỗi kết nối mongodb+srv://...
MONGO_URI=mongodb+srv://<db_huy>:<db_123456d>@cluster0.qz2pbrq.mongodb.net/`/mini_lms`?appName=Cluster0

# Khóa ký phiên đăng nhập — mỗi máy một chuỗi ngẫu nhiên, không chia sẻ lên GitHub.
JWT_SECRET=

# Địa chỉ frontend được phép gọi API
CORS_ORIGIN=http://localhost:5173
